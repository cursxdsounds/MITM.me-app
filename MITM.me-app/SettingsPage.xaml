<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:meApp="clr-namespace:MITM.me_app"
             x:Class="MITM.me_app.SettingsPage"
             BackgroundColor="#121212">

    <ContentPage.Resources>
        <!-- Стиль для активной кнопки (синяя) -->
        <Style x:Key="ActiveOptionButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#1565C0" />
            <Setter Property="TextColor" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HeightRequest" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderWidth" Value="0" />
        </Style>

        <!-- Стиль для неактивной кнопки -->
        <Style x:Key="OptionButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#2C2C2C" />
            <Setter Property="TextColor" Value="#E0E0E0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HeightRequest" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderWidth" Value="0" />
        </Style>

        <!-- Заголовок блока -->
        <Style x:Key="SectionHeader" TargetType="Label">
            <Setter Property="TextColor" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <!-- Поле ввода -->
        <Style x:Key="InputEntry" TargetType="Entry">
            <Setter Property="BackgroundColor" Value="#1E1E1E" />
            <Setter Property="TextColor" Value="#FFFFFF" />
            <Setter Property="PlaceholderColor" Value="#666666" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HeightRequest" Value="44" />
        </Style>

        <!-- Picker (выпадающий список) -->
        <Style x:Key="InputPicker" TargetType="Picker">
            <Setter Property="BackgroundColor" Value="#1E1E1E" />
            <Setter Property="TextColor" Value="#FFFFFF" />
            <Setter Property="TitleColor" Value="#666666" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HeightRequest" Value="44" />
        </Style>

        <!-- Подпись поля ввода -->
        <Style x:Key="InputLabel" TargetType="Label">
            <Setter Property="TextColor" Value="#AAAAAA" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <!-- Кнопка "Сохранить" -->
        <Style x:Key="SaveButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#2E7D32" />
            <Setter Property="TextColor" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HeightRequest" Value="38" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="BorderWidth" Value="0" />
            <Setter Property="HorizontalOptions" Value="End" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="15,20,15,30" Spacing="20">

            <!-- ===================== ВЫБОР КЛИЕНТА ===================== -->
            <VerticalStackLayout Spacing="0">
                <Label Text="Настройки клиента" Style="{StaticResource SectionHeader}" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button Grid.Column="0"
                            Text="Клиент 1"
                            Command="{Binding SelectClientCommand}"
                            CommandParameter="{x:Int32 1}"
                            Style="{StaticResource OptionButton}" >
                        <Button.Triggers>
                        <DataTrigger TargetType="Button"
                                     Binding="{Binding IsClient1Selected}"
                                     Value="True">
                            <Setter Property="Style" Value="{StaticResource ActiveOptionButton}" />
                        </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Grid.Column="1"
                            Text="Клиент 2"
                            Command="{Binding SelectClientCommand}"
                            CommandParameter="{x:Int32 2}"
                            Style="{StaticResource OptionButton}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button"
                                         Binding="{Binding IsClient2Selected}"
                                         Value="True">
                                <Setter Property="Style" Value="{StaticResource ActiveOptionButton}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>    
                </Grid>
            </VerticalStackLayout>

            <!-- ===================== ТЕМА ОБЩЕНИЯ ===================== -->
            <VerticalStackLayout Spacing="0">
                <Label Text="Тема общения" Style="{StaticResource SectionHeader}" />
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <Button Grid.Column="0"
                            Text="Общение"
                            Command="{Binding SelectTopicCommand}"
                            CommandParameter="Общение"
                            Style="{StaticResource ActiveOptionButton}" />
                    <Button Grid.Column="1"
                            Text="Фильтр 18+"
                            Command="{Binding SelectTopicCommand}"
                            CommandParameter="Фильтр 18+"
                            Style="{StaticResource OptionButton}" />
                    <Button Grid.Column="2"
                            Text="Ролка"
                            Command="{Binding SelectTopicCommand}"
                            CommandParameter="Ролка"
                            Style="{StaticResource OptionButton}" />
                </Grid>
            </VerticalStackLayout>

            <!-- ===================== НАСТРОЙКИ КЛИЕНТА 1 ===================== -->
            <VerticalStackLayout Spacing="20"
                                 IsVisible="{Binding IsClient1Selected}">

                <!-- ===== TOKEN / USERAGENT ===== -->
                <VerticalStackLayout Spacing="12">
                    <Label Text="Token:" Style="{StaticResource InputLabel}" />
                    <Entry Text="{Binding Client1Token}"
                           Placeholder="Введите Token"
                           Style="{StaticResource InputEntry}" />

                    <Label Text="UserAgent:" Style="{StaticResource InputLabel}" />
                    <Entry Text="{Binding Client1UserAgent}"
                           Placeholder="Введите UserAgent"
                           Style="{StaticResource InputEntry}" />

                    <Button Text="Сохранить"
                            Command="{Binding SaveCommand}"
                            CommandParameter="{x:Int32 1}"
                            Style="{StaticResource SaveButton}" />
                </VerticalStackLayout>

                <!-- ===== ПОЛ + ВОЗРАСТ (ВЫПАДАЮЩИЕ СПИСКИ) ===== -->
                <VerticalStackLayout Spacing="16"
                                     IsVisible="{Binding IsCommunicationActive}">

                    <!-- Пол -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                        <VerticalStackLayout Grid.Column="0" Spacing="6">
                            <Label Text="Ваш пол" Style="{StaticResource InputLabel}" />
                            <Picker Title="Выберите пол"
                                    ItemsSource="{Binding Genders}"
                                    SelectedItem="{Binding Client1Gender}"
                                    Style="{StaticResource InputPicker}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="Пол собеседника" Style="{StaticResource InputLabel}" />
                            <Picker Title="Выберите пол"
                                    ItemsSource="{Binding Genders}"
                                    SelectedItem="{Binding Client1TargetGender}"
                                    Style="{StaticResource InputPicker}" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Возраст -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                        <VerticalStackLayout Grid.Column="0" Spacing="6">
                            <Label Text="Ваш возраст" Style="{StaticResource InputLabel}" />
                            <Picker Title="Выберите возраст"
                                    ItemsSource="{Binding AgeRanges}"
                                    SelectedItem="{Binding Client1Age}"
                                    Style="{StaticResource InputPicker}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="Возраст собеседника" Style="{StaticResource InputLabel}" />
                            <Picker Title="Выберите возраст"
                                    ItemsSource="{Binding AgeRanges}"
                                    SelectedItem="{Binding Client1TargetAge}"
                                    Style="{StaticResource InputPicker}" />
                        </VerticalStackLayout>
                    </Grid>

                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- ===================== НАСТРОЙКИ КЛИЕНТА 2 ===================== -->
            <VerticalStackLayout Spacing="20"
                                 IsVisible="{Binding IsClient2Selected}">

                <!-- ===== TOKEN / USERAGENT ===== -->
                <VerticalStackLayout Spacing="12">
                    <Label Text="Token:" Style="{StaticResource InputLabel}" />
                    <Entry Text="{Binding Client2Token}"
                           Placeholder="Введите Token"
                           Style="{StaticResource InputEntry}" />

                    <Label Text="UserAgent:" Style="{StaticResource InputLabel}" />
                    <Entry Text="{Binding Client2UserAgent}"
                           Placeholder="Введите UserAgent"
                           Style="{StaticResource InputEntry}" />

                    <Button Text="Сохранить"
                            Command="{Binding SaveCommand}"
                            CommandParameter="{x:Int32 2}"
                            Style="{StaticResource SaveButton}" />
                </VerticalStackLayout>

                <!-- ===== ПОЛ + ВОЗРАСТ (ВЫПАДАЮЩИЕ СПИСКИ) ===== -->
                <VerticalStackLayout Spacing="16"
                                     IsVisible="{Binding IsCommunicationActive}">

                    <!-- Пол -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                        <VerticalStackLayout Grid.Column="0" Spacing="6">
                            <Label Text="Ваш пол" Style="{StaticResource InputLabel}" />
                            <Picker Title="Выберите пол"
                                    ItemsSource="{Binding Genders}"
                                    SelectedItem="{Binding Client2Gender}"
                                    Style="{StaticResource InputPicker}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="Пол собеседника" Style="{StaticResource InputLabel}" />
                            <Picker Title="Выберите пол"
                                    ItemsSource="{Binding Genders}"
                                    SelectedItem="{Binding Client2TargetGender}"
                                    Style="{StaticResource InputPicker}" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Возраст -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                        <VerticalStackLayout Grid.Column="0" Spacing="6">
                            <Label Text="Ваш возраст" Style="{StaticResource InputLabel}" />
                            <Picker Title="Выберите возраст"
                                    ItemsSource="{Binding AgeRanges}"
                                    SelectedItem="{Binding Client2Age}"
                                    Style="{StaticResource InputPicker}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="Возраст собеседника" Style="{StaticResource InputLabel}" />
                            <Picker Title="Выберите возраст"
                                    ItemsSource="{Binding AgeRanges}"
                                    SelectedItem="{Binding Client2TargetAge}"
                                    Style="{StaticResource InputPicker}" />
                        </VerticalStackLayout>
                    </Grid>

                </VerticalStackLayout>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>